# Copiar a ".env" en la raíz del proyecto (al lado de docker-compose.yml).
# IMPORTANTE: sin espacios alrededor del "=".

# ---------- App ----------
APP_PORT=3001
PROFILE=PROD
EXPIRES_IN=3600
JWT_SECRET=cambia-esto-por-un-secreto-largo

# ---------- PostgreSQL ----------
# Postgres instalado en el mismo servidor (fuera de Docker): host.docker.internal
# Postgres en contenedor (--profile db): postgres
# Postgres en otro servidor: su IP o hostname
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=elecciones
DB_USER=postgres
DB_PASSWORD=cambia-esto

# ---------- Docker / despliegue ----------
# Puerto público del frontend en el servidor
FRONT_PORT=80
# URL del backend vista desde el navegador. Vacío = mismo dominio (nginx hace proxy de /api)
API_URL=
