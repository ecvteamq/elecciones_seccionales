# Copiar a ".env" en esta carpeta (desarrollo sin Docker).
# Para Docker usa el .env.example de la raíz del proyecto.
# Formato: KEY=valor, sin espacios alrededor del "=".

# CONFIG
APP_PORT=3001
# Duración del token en segundos (o con unidad: 1h, 30m)
EXPIRES_IN=3600
PROFILE=DEV

# POSTGRES
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elecciones
DB_USER=postgres
DB_PASSWORD=cambia-esto

# JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo
